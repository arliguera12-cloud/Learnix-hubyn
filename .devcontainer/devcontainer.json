{
  "name": "Learnix DTE Hub (backend + frontend)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r backend/requirements.txt && npm --prefix frontend install",
  "portsAttributes": {
    "8000": { "label": "Backend API" },
    "5173": { "label": "Frontend (Vite)" }
  },
  "forwardPorts": [
    8000,
    5173
  ]
}
