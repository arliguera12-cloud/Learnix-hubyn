# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=
# Opcional: service_role key, para operaciones administrativas (healthcheck,
# directorio de clientes/proveedores en local_db.py). Si no se define, se usa
# SUPABASE_KEY. NUNCA exponer esta key en el frontend.
SUPABASE_SERVICE_KEY=
# Solo para proyectos que todavía firman con el secreto compartido (HS256).
# Los proyectos actuales de Supabase firman con claves asimétricas (ES256) y el
# backend las verifica solo con SUPABASE_URL, tomando la clave pública del JWKS
# del proyecto — en ese caso esta variable puede quedar vacía.
# Si tu proyecto aún emite tokens HS256, cópialo de Supabase →
# Project Settings → JWT Keys → pestaña "Legacy JWT Secret".
SUPABASE_JWT_SECRET=

# --- Groq (motor IA primario: texto + visión) ---
GROQ_API_KEY=

# --- Google Vertex AI / Gemini (motor IA secundario, opcional) ---
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1

# --- Entorno ---
# production | development. Controla CORS estricto y headers de seguridad (HSTS).
ENVIRONMENT=production

# --- CORS: orígenes explícitos permitidos, separados por coma ---
# ej. https://learnix.vercel.app,https://tudominio.com
ALLOWED_ORIGINS=

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=60
BLOCKED_IPS=

# --- Consulta pública de Hacienda (utils/mh_consulta.py) ---
# Hacienda corta con 429 por ~5 min al pasar de ~15 consultas seguidas; lo que
# lo evita es el ritmo, no la concurrencia. Valores por defecto entre paréntesis.
# Segundos entre consultas, global a la instancia (5 = 12 por minuto).
MH_CONSULTA_INTERVALO_S=5
# Máximo que un documento espera su turno; si la fila es más larga se omite la consulta (12).
MH_CONSULTA_ESPERA_MAX_S=12
# Pausa tras un 429 cuando Hacienda no manda Retry-After (300).
MH_CONSULTA_COOLDOWN_429_S=300
# Pausa tras un 403 (bloqueo, no tope de tasa) (600).
MH_CONSULTA_COOLDOWN_403_S=600
