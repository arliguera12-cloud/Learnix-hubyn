# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Groq (motor IA primario: texto + visión) ---
GROQ_API_KEY=

# --- Google Vertex AI / Gemini (motor IA secundario, opcional) ---
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1

# --- Contraseña de acceso a la app ---
APP_PASSWORD=

# --- CORS: orígenes extra permitidos, separados por coma (ej. tu URL de Vercel) ---
EXTRA_CORS_ORIGINS=

# --- Almacenamiento local JSON (clientes/proveedores) ---
# Override opcional; por defecto usa backend/data/. En Railway este directorio
# es efímero y se reinicia en cada deploy — limitación conocida.
# Migrar clientes/proveedores a tablas de Supabase queda como mejora futura.
LOCAL_DB_DIR=
