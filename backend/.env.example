# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=
# Opcional: service_role key, para operaciones administrativas (healthcheck,
# directorio de clientes/proveedores en local_db.py). Si no se define, se usa
# SUPABASE_KEY. NUNCA exponer esta key en el frontend.
SUPABASE_SERVICE_KEY=
# Settings → API → JWT Secret. Usado para verificar el JWT que emite Supabase Auth.
SUPABASE_JWT_SECRET=

# --- Groq (motor IA primario: texto + visión) ---
GROQ_API_KEY=

# --- Google Vertex AI / Gemini (motor IA secundario, opcional) ---
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1

# --- Entorno ---
# production | development. Controla CORS estricto y headers de seguridad (HSTS).
ENVIRONMENT=production

# --- CORS: orígenes explícitos permitidos, separados por coma ---
# ej. https://learnix.vercel.app,https://tudominio.com
ALLOWED_ORIGINS=

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=60
BLOCKED_IPS=
