# Configuración del worker de Hacienda. Copia este archivo como worker.env
# (sin .example) y completa los dos valores. No lo compartas ni lo subas a git.

# Dirección pública del backend en Railway, sin barra final.
# Ej.: https://learnix-hubyn-production.up.railway.app
LEARNIX_URL=

# Token compartido con el backend (32 caracteres o más). El MISMO valor va en
# la variable MH_RELAY_TOKEN del servicio en Railway. Para generarlo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MH_RELAY_TOKEN=

# Opcionales (valores por defecto):
# MH_WORKER_INTERVALO_S=4.5     # segundos entre consultas a Hacienda
# MH_WORKER_PAUSA_429_S=300     # pausa tras un 429 (tope de tasa)
# MH_WORKER_PAUSA_403_S=900     # pausa tras un 403
